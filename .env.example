# Liquida — variáveis de ambiente (copie para .env). spec-v1.0.0 §9
# Nenhum segredo real: valores locais de desenvolvimento.

# --- PostgreSQL ---
POSTGRES_USER=liquida
POSTGRES_PASSWORD=liquida
POSTGRES_DB=liquida
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Connection strings usadas pelos serviços .NET ---
# Producer/Consumer (Dapper + Npgsql)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=liquida;Username=liquida;Password=liquida
# RabbitMQ (Api publisher + Consumer)
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__User=guest
RabbitMq__Password=guest
